{
  "name": "clavis",
  "description": "Understand and pronounce selected text in webpages and PDFs.",
  "private": true,
  "version": "1.0.11",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "postinstall": "wxt prepare",
    "size": "node scripts/check-bundle-size.mjs",
    "audit:zip": "node scripts/audit-zip.mjs --strict",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "release:check": "node scripts/release-check.mjs",
    "ci": "npm run check && npm run build && npm run size && npm run zip && npm run audit:zip && node scripts/selftest.mjs && node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "preact": "^11.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "es-module-lexer": "2.3.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "0.21.4"
  }
}
