{
  // shared/ is compiled by three packages (extension, server, dashboard). Bundlers look up the
  // nearest tsconfig for these files; without this one they reach the root tsconfig, which extends
  // the generated .wxt/tsconfig.json and fails in jobs that never run `wxt prepare`. Type checking
  // still happens under each package's own tsconfig.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
