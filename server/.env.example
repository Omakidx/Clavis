# Names only; copy to .env for local development. Never commit values.
# Local services: docker compose -f server/docker-compose.dev.yml up -d
NODE_ENV=
PORT=
PUBLIC_ORIGIN=
LOG_LEVEL=
# Local compose Postgres is published on host port 5433 (5432 is often taken by another local Postgres).
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EXTENSION_IDS=
TOKEN_SIGNING_SECRET=
TOKEN_SIGNING_SECRET_PREVIOUS=
STATE_COOKIE_SECRET=
# Local compose MinIO: S3 API on host port 9000, console on 9001.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
TRUST_PROXY=
# Client IP source for per-IP rate limits: xff-rightmost (default) or x-real-ip; hops = trusted proxies appending to X-Forwarded-For.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
JOBS_ENABLED=
STORAGE_ALERT_BYTES=
# Integration tests only: Postgres URL they may create/drop schemas in. Tests skip when unset.
TEST_DATABASE_URL=
