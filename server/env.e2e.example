# Local dev against the fake Google (scripts/fake-google.mjs) and the dev Postgres. Copy to server/.env (npm run dev reads it).
# Every value here is a development placeholder, not a secret. Production REFUSES the GOOGLE_*_URL/ISSUER overrides.
NODE_ENV=development
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
DATABASE_URL=postgres://clavis:clavis-dev-only@127.0.0.1:5433/clavis
GOOGLE_CLIENT_ID=fake-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-client-secret
GOOGLE_AUTH_URL=http://127.0.0.1:8788/authorize
GOOGLE_TOKEN_URL=http://127.0.0.1:8788/token
GOOGLE_JWKS_URL=http://127.0.0.1:8788/jwks
GOOGLE_ISSUER=http://127.0.0.1:8788
ALLOWED_EXTENSION_IDS=ebfpdncfkebjagolnbmfdhikaipiflbl
# base64 of obviously fake text, >= 32 bytes and distinct from each other:
TOKEN_SIGNING_SECRET=Y2xhdmlzLWUyZS1GQUtFLXNpZ25pbmctbm90LWEtcmVhbC1zZWNyZXQ=
STATE_COOKIE_SECRET=Y2xhdmlzLWUyZS1GQUtFLXN0YXRlLW5vdC1hLXJlYWwtc2VjcmV0
JOBS_ENABLED=0
