{
  "manifest_version": 3,
  "name": "Clavis side panel gesture spike",
  "version": "1.0",
  "minimum_chrome_version": "147",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["cs.js"] }]
}
